{
  "name": "sapgui-java-mcp",
  "version": "0.14.0",
  "description": "MCP server that drives SAP GUI for Java through the in-GUI scripting bridge (scripts/bridge.js)",
  "type": "module",
  "bin": {
    "sapgui-java-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "smoke": "node dist/smoke.js",
    "test:live": "npm run build && node dist/live-test.js",
    "test": "npm run build && node --test test/"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.0"
  },
  "license": "MIT",
  "author": "Christian Guenter",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/christianguenter2/sapgui-java-mcp.git",
    "directory": "mcp"
  },
  "homepage": "https://github.com/christianguenter2/sapgui-java-mcp#readme",
  "bugs": {
    "url": "https://github.com/christianguenter2/sapgui-java-mcp/issues"
  },
  "keywords": [
    "sap",
    "sapgui",
    "sap-gui-for-java",
    "mcp",
    "model-context-protocol",
    "claude",
    "abap"
  ]
}
