{
  "name": "sapgui-java-mcp",
  "version": "0.1.0",
  "description": "MCP server that drives SAP GUI for Java through the in-GUI scripting bridge (scripts/bridge.js)",
  "type": "module",
  "bin": { "sapgui-java-mcp": "dist/index.js" },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "smoke": "node dist/smoke.js"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.0"
  }
}
